# Local tooling template. Keep real values only in the ignored .env file.
# Do not overwrite an existing .env: merge missing variable names instead.
# Docker Compose supplies its own runtime configuration.
# Standalone API/web templates: apps/api/.env.example and apps/web/.env.example.
RAILWAY_PROJECT_TOKEN=
RAILWAY_ACCOUNT_TOKEN=
GOOGLE_STITCH_API_KEY_MCP=

# Supabase Auth public configuration, required for P2/P3.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
