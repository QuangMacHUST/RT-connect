# Railway staging API variables. Set values in Railway, never commit an environment file.
APP_ENV=staging
APP_VERSION=replace-with-git-commit-or-release-version
LOG_LEVEL=INFO
DATABASE_URL=${{Postgres.DATABASE_URL}}
CORS_ALLOWED_ORIGINS=https://replace-with-staging-web-domain
SUPABASE_JWT_ISSUER=https://replace-with-staging-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://replace-with-staging-project.supabase.co/auth/v1/.well-known/jwks.json

# Backend-only operational limits. No Railway tooling token belongs here.
REQUEST_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=104857600
ENGINE_VERSION=unavailable-before-gamma-phase
RENDERER_VERSION=unavailable-before-report-phase

# P8 Gamma worker only; set these on the private worker service as well as the
# shared application/storage variables above. Leave GAMMA_WORKER_ONCE unset
# for a continuously polling staging worker.
GAMMA_WORKER_POLL_SECONDS=2
# GAMMA_WORKER_ONCE=1
