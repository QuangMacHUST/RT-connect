# This file belongs to the API working directory only. Do not copy it over repository-root .env,
# which is reserved for local deployment tooling credentials and is never passed to application containers.
APP_ENV=development
APP_VERSION=0.1.0-dev
SCHEMA_REVISION=20260908_0008
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://rt_connect:rt_connect@localhost:5432/rt_connect
REDIS_URL=redis://localhost:6379/0
GAMMA_QUEUE_STREAM=rt-connect:gamma
GAMMA_QUEUE_GROUP=rt-connect-gamma
GAMMA_QUEUE_VISIBILITY_TIMEOUT_SECONDS=120
GAMMA_QUEUE_MAXLEN=10000
GAMMA_LEASE_SECONDS=120
GAMMA_RETRY_MAX_ATTEMPTS=3
GAMMA_RETRY_BACKOFF_BASE_SECONDS=5
GAMMA_RETRY_BACKOFF_MAX_SECONDS=300
GAMMA_EXECUTION_DEADLINE_SECONDS=900
GAMMA_MAX_VOXELS=2000000
GAMMA_MAX_CANDIDATE_EVALUATIONS=50000000
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
CORRELATION_ID_HEADER=X-Correlation-ID
REQUEST_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=104857600
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rt-connect-artifacts
S3_ACCESS_KEY_ID=local-development-only
S3_SECRET_ACCESS_KEY=local-development-only
S3_SIGNED_URL_TTL_SECONDS=900
ENGINE_VERSION=unavailable-in-p1
RENDERER_VERSION=unavailable-in-p1
# P2: Supabase Auth only. Use the issuer and JWKS URL from the selected non-production
# Supabase Auth project. Never place a service-role key or a Railway token in this file.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
